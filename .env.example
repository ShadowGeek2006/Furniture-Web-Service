# ─────────────────────────────────────────────────────────
# Admin panel access (REQUIRED)
# The /admin section is password-protected. Set a strong,
# unique password and a long random secret before deploying.
# Generate a secret with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────
ADMIN_PANEL_PASSWORD="change-me-before-deploying"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"

# ─────────────────────────────────────────────────────────
# Meta WhatsApp Cloud API (OPTIONAL)
# If omitted, outgoing WhatsApp notifications are logged to
# the server console instead of actually being sent — useful
# for local development. Required for real dispatch in prod.
# ─────────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Shop's WhatsApp number that receives new-enquiry alerts,
# in international format with no + or spaces.
ADMIN_WHATSAPP_NUMBER="919999999999"

# ─────────────────────────────────────────────────────────
# Order/invoice data storage (OPTIONAL)
# Orders and invoices are persisted as JSON files on disk
# (no database server required). By default they're written
# to a "data" folder inside the project itself. Point this at
# a different folder if you want the data to live elsewhere
# (e.g. outside the app folder so it survives redeploys).
# ─────────────────────────────────────────────────────────
DATA_DIR="./data"

# ─────────────────────────────────────────────────────────
# Store/business details used on the printed GST tax invoice
# (REQUIRED for correct invoices — the app runs without these,
# but the invoice will show clearly-marked placeholder text
# instead of the real shop name/address/GSTIN until they're set)
# ─────────────────────────────────────────────────────────
STORE_NAME="Client Business Name"
STORE_ADDRESS="Full registered business address"
STORE_PHONE="+91-XXXXXXXXXX"
STORE_EMAIL="orders@example.com"
STORE_GSTIN="09XXXXXXXXXXXXX"
STORE_STATE="Uttar Pradesh"
STORE_STATE_CODE="09"
